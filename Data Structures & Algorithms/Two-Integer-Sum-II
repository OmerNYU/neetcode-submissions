class Solution:
    def twoSum(self, numbers: List[int], target: int) -> List[int]:
        l = 0 
        r = len(numbers) - 1

        while l < r:
            f_sum = numbers[l] + numbers[r]
            if f_sum < target:
                l += 1
            elif f_sum > target:
                r -= 1
            elif f_sum == target:
                return [l+1, r+1]
        
